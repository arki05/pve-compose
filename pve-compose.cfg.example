# /etc/pve/pve-compose.cfg -- cluster-wide, every key optional. Written by
# `pve-compose config set|unset` and by `new` when you let it store an
# answer; shown by `pve-compose config`. Editing it by hand works too.
template:
  storage: local                 # a storage with vztmpl content (cluster-wide)
  base: debian-13-standard       # the upstream template `new` unpacks (pveam downloads it)
defaults:
  rootfs_size: 8G
  owner: "1000:1000"
  bridge: vmbr0
  cores: 2
  memory: 2048
nodes:                           # disk storage is per node: names differ per node
  # StorageCube: { storage: NetApp }
limits:                          # what a guest's document may ask for (README, "Trust")
  bind_roots: []                 # host directories an x-pve.path may be or be under; empty: no binds
  storages: []                   # storages an x-pve.storage may name; empty: only the node's own
  max_disk_gib: 64               # the largest disk one x-pve.size may ask for
daemon:
  interval: 30                   # seconds between version-token polls
  full_every: 600                # seconds between unconditional passes
